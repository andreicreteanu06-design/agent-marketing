# Copiaza acest fisier in `.env` si completeaza valorile.
# `.env` este in .gitignore — NU il comite niciodata.
# Toate cheile au prefixul PPC_.

# Modul furnizorilor de date: "mock" (implicit) sau "live".
# "live" este momentan un stub si va ridica o eroare pana la integrarea reala.
PPC_PROVIDER_MODE=mock

# --- Google Ads API (doar pentru PPC_PROVIDER_MODE=live) ---
PPC_GOOGLE_ADS_DEVELOPER_TOKEN=
PPC_GOOGLE_ADS_CLIENT_ID=
PPC_GOOGLE_ADS_CLIENT_SECRET=
PPC_GOOGLE_ADS_REFRESH_TOKEN=
# Contul ale carui campanii sunt citite (fara prefixul "customers/", doar cifre).
PPC_GOOGLE_ADS_CUSTOMER_ID=
# Necesar DOAR daca accesezi contul de mai sus printr-un cont manager/MCC -
# altfel lasa-l gol.
PPC_GOOGLE_ADS_LOGIN_CUSTOMER_ID=

# --- Google Search Console + Google Business Profile (OAuth) ---
# ATENTIE la scope: un refresh token emis pentru Google Ads (scope 'adwords')
# NU merge pentru Search Console - acolo e nevoie de 'webmasters.readonly'.
# De aceea sunt doua token-uri, nu unul refolosit (vezi ClientAccount).
PPC_GOOGLE_OAUTH_CLIENT_ID=
PPC_GOOGLE_OAUTH_CLIENT_SECRET=
PPC_GOOGLE_OAUTH_REFRESH_TOKEN=
# Proprietatea Search Console, exact ca in interfata.
PPC_GSC_SITE_URL=
# Business Profile. API-ul cere 'Basic API Access' aprobat de Google
# (cerere separata, raspuns in 7-10 zile lucratoare).
PPC_GBP_ACCOUNT_ID=
PPC_GBP_LOCATION_ID=

# --- OpenSERP (pozitii in SERP pe cuvinte arbitrare) ---
# Instanta LOCALA, self-hosted - fara cheie, fara cont, fara cost recurent.
# Porneste-o cu Docker inainte de a urmari pozitii:
#   docker run --rm -p 127.0.0.1:7000:7000 karust/openserp:latest serve -a 0.0.0.0 -p 7000
# Fara ea, verificarile raporteaza "unavailable" si restul platformei
# (pozitiile reale din Search Console, analizele incrucisate) merge neschimbat.
PPC_OPENSERP_URL=http://localhost:7000
PPC_OPENSERP_LANGUAGE=RO
PPC_OPENSERP_REGION=RO

# --- Meta Marketing API (doar pentru live) ---
PPC_META_APP_ID=
PPC_META_APP_SECRET=
PPC_META_ACCESS_TOKEN=
PPC_META_AD_ACCOUNT_ID=
# Moneda contului Meta. Conteaza doar la aplicarea bugetelor: monedele fara
# subunitate (HUF, JPY, KRW...) se trimit x1, restul x100.
PPC_META_CURRENCY=RON

# --- TikTok Ads API (doar pentru live) ---
# Tokenul trebuie sa aiba drept si pe Events API: cu el pleaca si conversiile.
PPC_TIKTOK_ACCESS_TOKEN=
PPC_TIKTOK_ADVERTISER_ID=

# --- OpenAI Ads / ChatGPT (doar pentru live, acces de partener OpenAI) ---
# O cheie Ads API e legata de un singur cont de reclame. Per client, din setarile
# contului lui (chatgpt_ads_api_key); aceasta e doar pentru CLI.
PPC_CHATGPT_ADS_API_KEY=

# --- Client LLM pentru copywriter (doar pentru live) ---
# Ollama local, gratuit — datele nu parasesc masina (apel loopback).
# 1) instaleaza Ollama, 2) `ollama serve`, 3) `ollama pull llama3` (sau alt model).
# PPC_LLM_MODEL accepta si tag-ul fara prefix (ex. "llama3", "qwen2.5", "mistral").
PPC_LLM_MODEL=ollama/llama3
# Necompletat => implicit http://localhost:11434
PPC_LLM_ENDPOINT=
# Necompletat => Ollama decide (foloseste GPU daca detecteaza una).
# Seteaza "0" daca placa video produce raspunsuri corupte/incoerente (frecvent
# pe GPU-uri AMD slabe/nesuportate de ROCm) - forteaza CPU, mai lent dar corect.
PPC_LLM_NUM_GPU=

# --- Modulul 5: creatii audio/video (doar pentru live) ---
# Fish Speech ruleaza local (API sau CLI); Flick asambleaza video-ul final.
PPC_FISH_SPEECH_URL=
PPC_FISH_SPEECH_VOICE=ro_default
PPC_FLICK_ENDPOINT=
PPC_FLICK_API_KEY=

# ============================================================================
# ppc_agent_server (backend FastAPI) - variabile FARA prefixul PPC_, vezi
# ppc_agent_server/settings.py. Coexista fara conflict in acelasi .env.
# ============================================================================

# Necompletat => SQLite local (./ppc_agent_server.db). Seteaza pentru Postgres real.
DATABASE_URL=
# Necompletat => InlineJobQueue (sincron, in proces). Seteaza pentru ARQ+Redis real.
REDIS_URL=

# Automatizari native: transport email pentru API si worker (fara n8n).
# Oprit implicit. Activeaza doar dupa configurarea unui expeditor SMTP autorizat.
# false = STARTTLS obligatoriu; true = TLS implicit (uzual portul 465).
# Parola ramane pe server. Configurarea nu garanteaza livrarea in inbox.
AUTOMATION_EMAIL_ENABLED=false
AUTOMATION_SMTP_HOST=
AUTOMATION_SMTP_PORT=587
AUTOMATION_SMTP_USERNAME=
AUTOMATION_SMTP_PASSWORD=
AUTOMATION_SMTP_FROM=
AUTOMATION_SMTP_SSL=false


# Cheie de semnare pentru token-urile JWT ale clientilor (POST /signup, /login).
# Genereaz-o o singura data: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=

# Cheie Fernet pentru criptarea secretelor per-client (refresh/access tokens
# de pe conturile de reclame conectate prin PATCH /me/credentials). Genereaz-o
# o singura data si NU o schimba dupa ce exista secrete criptate cu ea (devin
# ilizibile): python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRETS_KEY=

# ID-ul (intreg) al Tenant-ului (agentia) caruia ii apartin conturile create
# prin POST /signup public - produsul e single-agentie azi. Fara el, /signup
# raspunde 503 in loc sa ghiceasca un tenant.
AGENCY_TENANT_ID=

# Conectarea Google din site (Search Console + Google Analytics 4, pagina
# /cont/seo-geo/integrari). Clientul OAuth e PPC_GOOGLE_OAUTH_CLIENT_ID/SECRET
# de mai sus - OBLIGATORIU acelasi, fiindca un refresh token Google merge doar
# cu clientul care l-a emis. In Google Cloud Console:
#   1. clientul OAuth e de tip "Web application", cu aceste "Authorized redirect URIs":
#        http://localhost:8000/api/v1/integrations/gsc/callback
#        http://localhost:8000/api/v1/integrations/ga4/callback
#      (in productie: PUBLIC_API_URL de mai jos + aceleasi cai)
#   2. activeaza "Google Search Console API", "Google Analytics Admin API" (lista
#      de proprietati GA4 din care alege clientul) si "Google Analytics Data API"
#      (traficul din pagina "Trafic & Pozitii").
# Adresa publica a API-ului (din ea se construieste redirect_uri) si a site-ului
# (unde revine clientul dupa ecranul Google).
PUBLIC_API_URL=http://localhost:8000
SITE_URL=http://localhost:3000

# Agentul Regina si consiliul lui - arhitectura hibrida (services/llm_client.py).
# Nici unul nu decide nimic: deciziile (ce trece, ce se taie, veto-ul) sunt
# calculate determinist inainte de orice model.
#
# Sistemul 2 - Ollama, LOCAL: tot textul scris pentru client - mesajul CMO
# (GET /api/v1/queen/client-message), parerile consiliului si sinteza Reginei
# (POST /api/v1/queen/chat, pana la 6 generari pe intrebare). Textul e respins
# (-> template) daca aduce cifre sau subiecte care nu sunt in date. Datele nu
# parasesc masina. Instalare: https://ollama.com, apoi `ollama pull llama3`.
# Accepta si "gazda[:port]" (portul implicit 11434). Necompletat (OLLAMA_HOST=)
# => mesajele vin din template-urile interne, fara niciun model. In Docker,
# containerul api foloseste OLLAMA_DOCKER_HOST (vezi docker-compose.yml).
OLLAMA_HOST=http://localhost:11434
# Necompletat => llama3 (acelasi model ca PPC_LLM_MODEL de mai sus: un singur
# `ollama pull`). Accepta si forma "ollama/<tag>".
OLLAMA_MODEL=
# Circuit-breaker-ul: fara niciun token in atatea secunde, Ollama intra 30 s in pauza
# si raspunde varianta determinista. Cat timp tokenii curg, generarea nu mai are
# termen de raspuns (raspunsul vine in flux, si in chat - SSE). Singurul apel LLM al
# consiliului e sinteza Reginei (~2-3k tokeni de prompt): pe CPU porneste in ~45 s.
OLLAMA_FIRST_TOKEN_TIMEOUT=180
# Scutul financiar: suma bugetelor zilnice angajate pe TOATA platforma (toti
# clientii) nu trece de aici, orice ar permite limita fiecarui client. In lei:
# aplicarea pe un cont Meta cu PPC_META_CURRENCY diferit de RON e refuzata.
MAX_DAILY_SPEND_RON=50
# Codul "Test Events" din Meta Events Manager: conversiile trimise prin
# Conversions API apar doar in tab-ul de test, fara sa antreneze optimizarea.
# Completeaza-l la inceputul pilotului; goleste-l cand evenimentele arata corect.
META_CAPI_TEST_EVENT_CODE=
# La fel pentru TikTok (codul din Events Manager > Test Events) si OpenAI Ads
# (true = evenimentele se verifica, dar nu se salveaza si nu antreneaza nimic).
TIKTOK_EVENTS_TEST_CODE=
CHATGPT_CONVERSIONS_VALIDATE_ONLY=false
# Textele Reginei scrise de Ollama (sinteza consiliului si mesajul CMO). false
# (implicit, CPU): textele deterministe pleaca instant, fara niciun apel la Ollama.
# true: doar cu un model mare, pe GPU.
USE_LLM_SYNTHESIS=false
# Modelul Ollama cu vision pentru CCO (POST /api/v1/creative/upload), ex. qwen2.5vl:3b
# sau llava:7b (trebuie descarcat cu «ollama pull»). Gol = evaluarea raspunde 503.
OLLAMA_VISION_MODEL=
# Modelul whisper.cpp (ggml) cu care CCO-ul transcrie vocea din video-uri, ex.
# C:\modele\ggml-small-q5_1.bin. Gol = vocea nu se transcrie (sunetul se măsoară oricum).
WHISPER_MODEL=
# Cheia ElevenLabs (opțional): cu ea, vocea o transcrie ElevenLabs Scribe în locul lui
# whisper - română mai bună, dar sunetul clienților pleacă la ElevenLabs (cost pe minut).
ELEVENLABS_API_KEY=
# Modelul de embeddings pentru trendurile CCO-ului (RAG), ex. nomic-embed-text
# (`ollama pull nomic-embed-text`, ~274 MB). Gol = vectori lexicali locali, fără model.
OLLAMA_EMBED_MODEL=
# Cheia automatizării săptămânale de trenduri (GitHub Actions -> POST /api/v1/trends/ingest,
# antetul X-Cron-Secret). Aceeași valoare și în secretul CRON_SECRET_KEY din GitHub.
# Minimum 32 de caractere: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Gol = ruta e oprită (503).
CRON_SECRET_KEY=
# Cate generari deodata pe serverul Ollama: 1 pe CPU; cu GPU, cat OLLAMA_NUM_PARALLEL.
OLLAMA_MAX_PARALLEL=1
# Cat tine Ollama modelul incarcat intre cereri ("30m", "2h", "-1" = mereu).
# Necompletat => implicitul Ollama (5 min), dupa care prima cerere il reincarca.
OLLAMA_KEEP_ALIVE=30m
# Pe CPU, un model mic, cuantizat, de pe Hugging Face (huggingface_hub, cache in
# HF_HOME): python -m ppc_agent_server.hf_manager install, apoi
# OLLAMA_MODEL=qwen2.5-1.5b-q4km. HF_HOME trebuie sa fie pe un disc persistent,
# altfel modelele se descarca din nou dupa fiecare repornire.
# Doar pentru docker-compose.yml: unde gaseste containerul api serverul Ollama.
# Necompletat => http://host.docker.internal:11434 (Ollama pornit pe host).
OLLAMA_DOCKER_HOST=
#
# Sistemul 1 - Jev (TypeSafe AI), decizii structurate si rapide: noteaza
# impactul si efortul mutarilor CPO-ului (RICE) si pastreaza doar fragmentele
# web despre nisa clientului (Researcher-ul). Se plateste doar pe tokenii de
# intrare. Necompletat => reguli fixe (estimarile RICE din tabel, toate
# fragmentele web). Cheie de pe console.typesafe.ai.
# ATENTIE: cu cheia setata, mutarile de oferta si fragmentele gasite pe web se
# trimit catre api.typesafe.ai (nu si cifrele PPC sau intrebarile din chat).
# Obligatorie pentru CCO (POST /api/v1/creative/upload): textul citit de pe creativa si
# transcrierea vocii pleaca la Jev (imaginea si sunetul raman pe server).
JEV_API_KEY=
# Gol = TypeSafe direct. Prin OpenCode Zen (acelasi protocol; JEV_API_KEY = cheia OpenCode):
#   JEV_URL=https://opencode.ai/zen/v1/systemone
#   JEV_MODEL=jev-1.13-free   (gratuit "pentru o perioada limitata"; platit: jev-1.13)
JEV_URL=
JEV_MODEL=
# Adminii platformei (emailurile de login, separate prin virgula). Doar ei pot scrie in
# chatul consiliului «oprește campaniile» / «oprește tot» (oprirea de urgenta: campaniile
# lansate de platforma pe pauza, nicio cheltuiala noua) si «repornește agentul».
ADMIN_EMAILS=


# ============================================================================
# seo_geo_agent (agent AI SEPARAT, propriul FastAPI app pe alt port) -
# variabile cu prefixul SEOGEO_, vezi seo_geo_agent/settings.py. Coexista fara
# conflict in acelasi .env.
# ============================================================================

# Modul furnizor: "mock" (implicit, determinist, fara Ollama pornit) sau "live".
SEOGEO_PROVIDER_MODE=mock

# --- Client LLM (doar pentru SEOGEO_PROVIDER_MODE=live) ---
# Ollama local, gratuit - datele nu parasesc masina (apel loopback), acelasi
# principiu ca PPC_LLM_MODEL de mai sus. 1) instaleaza Ollama, 2) `ollama serve`,
# 3) `ollama pull llama3` (sau alt model).
SEOGEO_LLM_MODEL=ollama/llama3
# Necompletat => implicit http://localhost:11434
SEOGEO_LLM_ENDPOINT=
# Necompletat => Ollama decide. Seteaza "0" pentru a forta CPU (vezi PPC_LLM_NUM_GPU).
SEOGEO_LLM_NUM_GPU=

# Originile carora CORSMiddleware le permite cereri din browser. Implicit doar
# serverul Next.js local. Lista separata prin virgula.
SEOGEO_CORS_ALLOWED_ORIGINS=http://localhost:3000

# NU seta o variabila SEOGEO_JWT_SECRET_KEY - acest serviciu citeste
# INTENTIONAT JWT_SECRET_KEY (fara prefix, definit mai sus, comun cu
# ppc_agent_server) ca un client autentificat pe site sa foloseasca acelasi
# token si aici, fara un al doilea login.

# --- Auditul determinist (seo_geo_agent/audit/) ---
# Auditul NU are nevoie de nicio cheie si nu foloseste LLM - merge din prima.
# Plafonul absolut de pagini per audit, indiferent ce cere clientul. Fiecare
# pagina inseamna o cerere HTTP catre site-ul lui: limita e si politete, si
# protectie pentru proces (nu exista coada de joburi - vezi audit/store.py).
SEOGEO_AUDIT_MAX_PAGES=100
# Dupa atatea secunde crawl-ul se opreste, iar raportul se marcheaza PARTIAL
# (completed=false), in loc sa tina clientul agatat la nesfarsit.
SEOGEO_AUDIT_TIME_BUDGET_SECONDS=150
# ATENTIE la deploy: auditurile traiesc in memoria procesului, deci agentul
# trebuie rulat cu UN SINGUR worker uvicorn (fara --workers N).

# --- Date externe gratuite (seo_geo_agent/external_data.py, neintegrate inca
# in engine.py) ---
# Optional: fara ea, Google PageSpeed Insights functioneaza tot, doar cu o cota
# mai mica. Microlink.io si LanguageTool nu au nevoie de nicio cheie.
SEOGEO_PAGESPEED_API_KEY=
# Token gratuit de pe huggingface.co/settings/tokens (rol "Read" e suficient).
# Fara el, fetch_semantic_embedding nu face niciun apel - Hugging Face refuza
# cereri anonime pentru majoritatea modelelor.
SEOGEO_HUGGINGFACE_API_KEY=

# ============================================================================
# Docker (docker-compose.yml) - stiva de productie
# ============================================================================
# Parolele bazei de date si ale cozii. Postgres si Redis nu au porturi publicate
# (traiesc pe o retea interna); parolele protejeaza oricum fiecare conexiune.
# Genereaza-le fara caractere speciale (intra in URL-uri):
#   python -c "import secrets; print(secrets.token_hex(24))"
POSTGRES_PASSWORD=
# Parola rolului limitat ppc_app, cu care se conecteaza API-ul si worker-ul (doar
# citire si scriere de randuri). Alta decat POSTGRES_PASSWORD. Containerul "migrate"
# creeaza rolul si ii pune parola asta la fiecare pornire.
POSTGRES_APP_PASSWORD=
REDIS_PASSWORD=
# Unde scrie serviciul "backup" un pg_dump pe zi (pastrat 14 zile). Implicit
# ./backups, langa proiect. Un folder sincronizat (OneDrive, Google Drive) il
# pastreaza si daca discul calculatorului cedeaza.
# BACKUP_DIR=./backups
# Adresele PUBLICE ale API-urilor, asa cum le vede browserul - intra in build-ul
# site-ului (NEXT_PUBLIC_*). In productie: https://api.domeniul-tau.ro etc.
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SEO_GEO_API_URL=http://localhost:8001
# Pe ce interfata asculta porturile publicate (3000, 8000, 8001). Implicit
# 127.0.0.1: in fata lor sta un reverse proxy cu TLS. 0.0.0.0 = direct din retea.
BIND_ADDRESS=127.0.0.1
# IP-ul reverse proxy-ului: numai de la el se accepta X-Forwarded-For (IP-ul real
# al clientului, pentru limitarea incercarilor de login).
FORWARDED_ALLOW_IPS=127.0.0.1
