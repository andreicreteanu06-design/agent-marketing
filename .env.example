# Copiaza acest fisier in `.env` si completeaza valorile.
# `.env` este in .gitignore — NU il comite niciodata.
# Toate cheile au prefixul PPC_.

# Modul furnizorilor de date: "mock" (implicit) sau "live".
# "live" este momentan un stub si va ridica o eroare pana la integrarea reala.
PPC_PROVIDER_MODE=mock

# --- Google Ads API (doar pentru PPC_PROVIDER_MODE=live) ---
PPC_GOOGLE_ADS_DEVELOPER_TOKEN=
PPC_GOOGLE_ADS_CLIENT_ID=
PPC_GOOGLE_ADS_CLIENT_SECRET=
PPC_GOOGLE_ADS_REFRESH_TOKEN=
# Contul ale carui campanii sunt citite (fara prefixul "customers/", doar cifre).
PPC_GOOGLE_ADS_CUSTOMER_ID=
# Necesar DOAR daca accesezi contul de mai sus printr-un cont manager/MCC -
# altfel lasa-l gol.
PPC_GOOGLE_ADS_LOGIN_CUSTOMER_ID=

# --- Google Search Console + Google Business Profile (OAuth) ---
PPC_GOOGLE_OAUTH_CLIENT_ID=
PPC_GOOGLE_OAUTH_CLIENT_SECRET=
PPC_GOOGLE_OAUTH_REFRESH_TOKEN=

# --- Meta Marketing API (doar pentru live) ---
PPC_META_APP_ID=
PPC_META_APP_SECRET=
PPC_META_ACCESS_TOKEN=
PPC_META_AD_ACCOUNT_ID=

# --- TikTok Ads API (doar pentru live) ---
PPC_TIKTOK_ACCESS_TOKEN=
PPC_TIKTOK_ADVERTISER_ID=

# --- Client LLM pentru copywriter (doar pentru live) ---
# Ollama local, gratuit — datele nu parasesc masina (apel loopback).
# 1) instaleaza Ollama, 2) `ollama serve`, 3) `ollama pull llama3` (sau alt model).
# PPC_LLM_MODEL accepta si tag-ul fara prefix (ex. "llama3", "qwen2.5", "mistral").
PPC_LLM_MODEL=ollama/llama3
# Necompletat => implicit http://localhost:11434
PPC_LLM_ENDPOINT=
# Necompletat => Ollama decide (foloseste GPU daca detecteaza una).
# Seteaza "0" daca placa video produce raspunsuri corupte/incoerente (frecvent
# pe GPU-uri AMD slabe/nesuportate de ROCm) - forteaza CPU, mai lent dar corect.
PPC_LLM_NUM_GPU=

# --- Modulul 5: creatii audio/video (doar pentru live) ---
# Fish Speech ruleaza local (API sau CLI); Flick asambleaza video-ul final.
PPC_FISH_SPEECH_URL=
PPC_FISH_SPEECH_VOICE=ro_default
PPC_FLICK_ENDPOINT=
PPC_FLICK_API_KEY=

# ============================================================================
# ppc_agent_server (backend FastAPI) - variabile FARA prefixul PPC_, vezi
# ppc_agent_server/settings.py. Coexista fara conflict in acelasi .env.
# ============================================================================

# Necompletat => SQLite local (./ppc_agent_server.db). Seteaza pentru Postgres real.
DATABASE_URL=
# Necompletat => InlineJobQueue (sincron, in proces). Seteaza pentru ARQ+Redis real.
REDIS_URL=

# Cheie de semnare pentru token-urile JWT ale clientilor (POST /signup, /login).
# Genereaz-o o singura data: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=

# Cheie Fernet pentru criptarea secretelor per-client (refresh/access tokens
# de pe conturile de reclame conectate prin PATCH /me/credentials). Genereaz-o
# o singura data si NU o schimba dupa ce exista secrete criptate cu ea (devin
# ilizibile): python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRETS_KEY=

# ID-ul (intreg) al Tenant-ului (agentia) caruia ii apartin conturile create
# prin POST /signup public - produsul e single-agentie azi. Fara el, /signup
# raspunde 503 in loc sa ghiceasca un tenant.
AGENCY_TENANT_ID=

# ============================================================================
# seo_geo_agent (agent AI SEPARAT, propriul FastAPI app pe alt port) -
# variabile cu prefixul SEOGEO_, vezi seo_geo_agent/settings.py. Coexista fara
# conflict in acelasi .env.
# ============================================================================

# Modul furnizor: "mock" (implicit, determinist, fara Ollama pornit) sau "live".
SEOGEO_PROVIDER_MODE=mock

# --- Client LLM (doar pentru SEOGEO_PROVIDER_MODE=live) ---
# Ollama local, gratuit - datele nu parasesc masina (apel loopback), acelasi
# principiu ca PPC_LLM_MODEL de mai sus. 1) instaleaza Ollama, 2) `ollama serve`,
# 3) `ollama pull llama3` (sau alt model).
SEOGEO_LLM_MODEL=ollama/llama3
# Necompletat => implicit http://localhost:11434
SEOGEO_LLM_ENDPOINT=
# Necompletat => Ollama decide. Seteaza "0" pentru a forta CPU (vezi PPC_LLM_NUM_GPU).
SEOGEO_LLM_NUM_GPU=

# Originile carora CORSMiddleware le permite cereri din browser. Implicit doar
# serverul Next.js local. Lista separata prin virgula.
SEOGEO_CORS_ALLOWED_ORIGINS=http://localhost:3000

# NU seta o variabila SEOGEO_JWT_SECRET_KEY - acest serviciu citeste
# INTENTIONAT JWT_SECRET_KEY (fara prefix, definit mai sus, comun cu
# ppc_agent_server) ca un client autentificat pe site sa foloseasca acelasi
# token si aici, fara un al doilea login.

# --- Auditul determinist (seo_geo_agent/audit/) ---
# Auditul NU are nevoie de nicio cheie si nu foloseste LLM - merge din prima.
# Plafonul absolut de pagini per audit, indiferent ce cere clientul. Fiecare
# pagina inseamna o cerere HTTP catre site-ul lui: limita e si politete, si
# protectie pentru proces (nu exista coada de joburi - vezi audit/store.py).
SEOGEO_AUDIT_MAX_PAGES=100
# Dupa atatea secunde crawl-ul se opreste, iar raportul se marcheaza PARTIAL
# (completed=false), in loc sa tina clientul agatat la nesfarsit.
SEOGEO_AUDIT_TIME_BUDGET_SECONDS=150
# ATENTIE la deploy: auditurile traiesc in memoria procesului, deci agentul
# trebuie rulat cu UN SINGUR worker uvicorn (fara --workers N).

# --- Date externe gratuite (seo_geo_agent/external_data.py, neintegrate inca
# in engine.py) ---
# Optional: fara ea, Google PageSpeed Insights functioneaza tot, doar cu o cota
# mai mica. Microlink.io si LanguageTool nu au nevoie de nicio cheie.
SEOGEO_PAGESPEED_API_KEY=
# Token gratuit de pe huggingface.co/settings/tokens (rol "Read" e suficient).
# Fara el, fetch_semantic_embedding nu face niciun apel - Hugging Face refuza
# cereri anonime pentru majoritatea modelelor.
SEOGEO_HUGGINGFACE_API_KEY=
