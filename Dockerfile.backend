# syntax=docker/dockerfile:1.7
#
# Imaginea backend-ului: O SINGURA imagine pentru trei procese (vezi
# docker-compose.yml) - API-ul PPC (ppc_agent_server), worker-ul ARQ si agentul
# SEO/GEO (seo_geo_agent). Difera doar comanda.
#
# Slim, fara Playwright (crawler-ul e httpx, cu scut SSRF), fara compilatoare in
# imaginea finala, torch doar CPU (build-ul implicit de pe PyPI aduce CUDA - cativa
# GB pe care un server fara GPU nu-i foloseste), utilizator fara privilegii.
#
# Exceptia: stadiul "worker" (la final) adauga Playwright + Chromium, DOAR pentru
# worker-ul ARQ - monitorizarea sintetica a tracking-ului (jobs/synthetic.py).

ARG PYTHON_VERSION=3.13

# --- 1. dependintele, intr-un venv ------------------------------------------------
FROM python:${PYTHON_VERSION}-slim AS deps

ENV PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PYTHONDONTWRITEBYTECODE=1

RUN python -m venv /opt/venv
ENV PATH="/opt/venv/bin:${PATH}"

WORKDIR /build
COPY requirements.txt requirements-server.txt requirements-seo-geo.txt constraints.txt ./
# constraints.txt = versiunile exacte pe care au rulat testele: imaginea nu ia o
# versiune mai noua, netestata, doar pentru ca intervalul din requirements o permite.
# Torch vine de pe indexul CPU, la versiunea testata; indexul acela nu are toate
# versiunile dependentelor lui (filelock...), deci ele se aliniaza abia la pasul
# urmator, de pe PyPI, cu aceleasi constrangeri.
RUN pip install --index-url https://download.pytorch.org/whl/cpu "$(grep -E '^torch==' constraints.txt)" \
 && pip install -c constraints.txt -r requirements-server.txt -r requirements-seo-geo.txt \
 && ! pip show playwright >/dev/null 2>&1

# --- 2. imaginea finala -----------------------------------------------------------
FROM python:${PYTHON_VERSION}-slim AS runtime

ENV PATH="/opt/venv/bin:${PATH}" \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    # Radacina containerului e read-only (docker-compose.yml): orice cache merge in /tmp.
    HOME=/tmp \
    XDG_CACHE_HOME=/tmp/.cache

RUN groupadd --system --gid 10001 app \
 && useradd --system --uid 10001 --gid app --home-dir /app --shell /usr/sbin/nologin app

# CCO-ul (POST /api/v1/creative/upload): ffmpeg masoara video-ul si sunetul, Tesseract
# (cu romana) citeste textul de pe creative. ffmpeg-ul din Debian n-are filtrul whisper:
# in Docker, vocea o transcrie ElevenLabs (ELEVENLABS_API_KEY).
RUN apt-get update \
 && apt-get install -y --no-install-recommends ffmpeg tesseract-ocr tesseract-ocr-ron \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY --from=deps /opt/venv /opt/venv
COPY --chown=root:root ppc_agent ./ppc_agent
COPY --chown=root:root ppc_agent_server ./ppc_agent_server
COPY --chown=root:root seo_geo_agent ./seo_geo_agent
COPY --chown=root:root alembic.ini swipe_file.json ./

# Singurul loc in care aplicatia scrie pe disc (creatiile audio/video ale jobului
# de creative) - in compose e un volum.
RUN mkdir -p /app/creative_output && chown app:app /app/creative_output

USER app

EXPOSE 8000 8001

# Pornirea API-ului (torch, pandas, toate modulele) dureaza 1-3 minute, mai mult pe
# un calculator ocupat sau imediat dupa un restart: cu o perioada de pornire scurta,
# containerul iesea "unhealthy", iar site-ul (care il asteapta sanatos) nu mai pornea.
# In perioada de pornire esecurile nu se numara; primul raspuns bun il face sanatos.
HEALTHCHECK --interval=30s --timeout=5s --start-period=300s --retries=3 \
  CMD python -c "import os, urllib.request; urllib.request.urlopen('http://127.0.0.1:' + os.environ.get('HEALTH_PORT', '8000') + '/health', timeout=4)"

# --proxy-headers: IP-ul real al clientului (limitarea de login) vine din
# X-Forwarded-For doar de la proxy-urile din FORWARDED_ALLOW_IPS.
CMD ["uvicorn", "ppc_agent_server.app:app", "--host", "0.0.0.0", "--port", "8000", "--proxy-headers"]

# --- 3. worker: acelasi runtime + Chromium, doar aici -----------------------------
# API-ul si agentul SEO/GEO raman pe "runtime" (fara browser); docker-compose.yml
# construieste worker-ul cu "target: worker".
FROM runtime AS worker
USER root
ENV PLAYWRIGHT_BROWSERS_PATH=/ms-playwright
COPY requirements-worker.txt constraints.txt /tmp/worker/
# --only-shell: Chromium headless, fara browserul complet (cateva sute de MB mai putin).
RUN pip install --no-cache-dir -c /tmp/worker/constraints.txt -r /tmp/worker/requirements-worker.txt \
 && playwright install --with-deps --only-shell chromium \
 && rm -rf /tmp/worker /var/lib/apt/lists/*
USER app
CMD ["arq", "ppc_agent_server.jobs.worker.WorkerSettings"]
