# syntax=docker/dockerfile:1.7
#
# Site-ul Next.js (site/), construit ca "standalone": imaginea finala are doar
# server.js si fisierele urmarite de build, fara node_modules-ul de dezvoltare.
#
# Contextul de build e ./site (vezi docker-compose.yml):
#   docker build -f Dockerfile.frontend site
#
# NEXT_PUBLIC_* sunt INLOCUITE in JavaScript la build (ajung in browser) - de-asta
# sunt argumente de build, nu variabile de rulare. Nu pune secrete in ele.

ARG NODE_VERSION=22

# --- 1. dependintele ---------------------------------------------------------------
FROM node:${NODE_VERSION}-alpine AS deps
RUN apk add --no-cache libc6-compat
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund

# --- 2. build-ul -------------------------------------------------------------------
FROM node:${NODE_VERSION}-alpine AS builder
WORKDIR /app
ARG NEXT_PUBLIC_API_URL=http://localhost:8000
ARG NEXT_PUBLIC_SEO_GEO_API_URL=http://localhost:8001
ENV NEXT_PUBLIC_API_URL=${NEXT_PUBLIC_API_URL} \
    NEXT_PUBLIC_SEO_GEO_API_URL=${NEXT_PUBLIC_SEO_GEO_API_URL} \
    NEXT_TELEMETRY_DISABLED=1
COPY --from=deps /app/node_modules ./node_modules
COPY . .
RUN npm run build

# --- 3. imaginea finala ------------------------------------------------------------
FROM node:${NODE_VERSION}-alpine AS runtime
WORKDIR /app
ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    PORT=3000 \
    HOSTNAME=0.0.0.0

RUN addgroup --system --gid 10001 app \
 && adduser --system --uid 10001 --ingroup app app

COPY --from=builder /app/public ./public
COPY --from=builder /app/.next/standalone ./
COPY --from=builder /app/.next/static ./.next/static
# Cache-ul de imagini/ISR - singurul loc scris la rulare (in compose: tmpfs).
RUN mkdir -p .next/cache && chown -R app:app .next/cache

USER app
EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:3000/').then(r => process.exit(r.ok ? 0 : 1)).catch(() => process.exit(1))"

CMD ["node", "server.js"]
